# AWS Configuration
# No access keys needed in production — Amplify uses its IAM service role.
# For local dev, either configure ~/.aws/credentials or set AWS_ACCESS_KEY_ID
# and AWS_SECRET_ACCESS_KEY in your shell (these work locally, just not on Amplify).
MEF_AWS_REGION=ap-southeast-1
MEF_S3_BUCKET=meforum
MEF_DYNAMODB_TABLE=mef-registrations

# byl.mn Payment
BYL_API_TOKEN=
BYL_PROJECT_ID=
BYL_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
